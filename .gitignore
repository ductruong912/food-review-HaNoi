# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing & e2e
/coverage
/test-results/
/playwright-report/
/blob-report/
playwright/.cache/

# next.js & builds
/.next/
/.next*/
/out/
/build/
/dist/

# supabase (local dev runtime & state)
/supabase/.branches/
/supabase/.temp/

# environment variables
.env*
!.env*.example
!.env.example
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-debug.log*

# editors & IDEs
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.sublime-workspace
*.sublime-project
*.sw?

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.pem

# AI / agent tooling & local caches
/.agents/
/.notebook/
/.codegraph/
